<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Most of SmartZoom.Interop is Win32 and is verified live (docs/testing.md). This project is for the parts
    that are not: plumbing with no P/Invoke in it, where a mistake is a concurrency bug rather than something
    a smoke test would show.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartZoom.Interop\SmartZoom.Interop.csproj" />
  </ItemGroup>

</Project>
