<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The measurement tool. Every empirical constant in docs/measurements.md was produced with one of these
    subcommands, and can be reproduced on other hardware with the same one. It is in the solution and built
    by CI so that it cannot quietly rot while the code it measures moves on.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartZoom.Probe</RootNamespace>
    <AssemblyName>smartzoom-probe</AssemblyName>

    <!-- It is a diagnostic tool, not a library: XML docs on its internals would be noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- System.Drawing, for the screenshot comparisons; it ships with the desktop framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartZoom.Core\SmartZoom.Core.csproj" />
    <ProjectReference Include="..\..\src\SmartZoom.Interop\SmartZoom.Interop.csproj" />
  </ItemGroup>

</Project>
