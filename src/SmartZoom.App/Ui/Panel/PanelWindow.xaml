<Window x:Class="SmartZoom.App.Ui.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="SmartZoom"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource Font.Body}"
        Foreground="{DynamicResource Brush.Ink}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">

    <!-- The margin is the room the shadow needs; the window itself is transparent outside the card. -->
    <Border Width="360"
            Margin="16"
            Padding="18,16,18,16"
            Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.CardBorder}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.22" ShadowDepth="4" Color="#0B1B33" />
        </Border.Effect>

        <StackPanel>

            <!-- 1. Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="8">
                    <TextBlock Style="{StaticResource Glyph}"
                               FontSize="13"
                               Foreground="White"
                               Text="&#xE71E;" />
                </Border>
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Base}"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="SmartZoom" />
                <Button Grid.Column="2"
                        Style="{StaticResource Button.TitleGlyph}"
                        Width="32"
                        Height="32"
                        Command="{Binding OpenSettings}"
                        Content="&#xE713;"
                        ToolTip="Open settings" />
            </Grid>

            <!-- 2. State -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource Text.Value}"
                           VerticalAlignment="Center"
                           FontSize="26"
                           Text="{Binding StateHeadline}" />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Pill}"
                        Height="34"
                        Padding="18,0"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleEnabled}"
                        Content="{Binding ToggleLabel}" />
            </Grid>

            <Border Style="{StaticResource Rule}" Margin="0,16,0,0" />

            <!-- 3. Your trigger -->
            <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,0" Text="YOUR TRIGGER" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource Text.Base}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding TriggerName}" />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Quiet}"
                        Height="32"
                        Padding="14,0"
                        Command="{Binding ChangeTrigger}"
                        Content="Change" />
            </Grid>

            <Border Style="{StaticResource Rule}" Margin="0,16,0,0" />

            <!-- 4. Zoom amount -->
            <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,0" Text="ZOOM AMOUNT" />
            <ItemsControl Margin="0,6,-8,0" ItemsSource="{Binding ZoomAmounts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Segment}"
                                Margin="0,0,8,0"
                                Command="{Binding DataContext.SetZoomAmount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding Label}"
                                Tag="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. Don't zoom in the last application. Hidden until something has been zoomed. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLastProcess}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Rule}" Margin="0,16,0,0" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource Text.Body}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Text="{Binding IgnoreLabel}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource Switch}"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleIgnored}"
                            Tag="{Binding IsIgnored}" />
                </Grid>
            </StackPanel>

            <!-- 6. Footer -->
            <TextBlock Style="{StaticResource Text.Muted}"
                       Margin="0,16,0,0"
                       FontSize="11.5"
                       Text="{Binding Footer}" />
        </StackPanel>
    </Border>
</Window>
