<Window x:Class="SmartZoom.App.Ui.Recorder.TriggerRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Trigger"
        Width="660"
        SizeToContent="Height"
        Background="{DynamicResource Brush.Ground}"
        FontFamily="{DynamicResource Font.Body}"
        Foreground="{DynamicResource Brush.Ink}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!--
        The same frameless chrome as the settings window, so the recorder does not look like a different
        application. CaptionHeight drags it; the close button opts back in to hit-testing.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Ground}">
        <StackPanel>

            <!-- Title bar -->
            <Border Height="44" Background="{DynamicResource Brush.TitleBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="22"
                            Height="22"
                            Margin="14,0,0,0"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="7">
                        <TextBlock Style="{StaticResource Glyph}"
                                   FontSize="11"
                                   Foreground="White"
                                   Text="&#xE8A3;" />
                    </Border>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Style="{StaticResource Text.Base}"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Close}"
                            Height="44"
                            Click="OnCancel"
                            Content="&#xE8BB;"
                            ToolTip="Cancel" />
                </Grid>
            </Border>

            <StackPanel Margin="22,18,22,20">

                <TextBlock Style="{StaticResource Text.Muted}"
                           Text="Press the mouse button or key combination you want to use. A left or right click counts only with Ctrl, Alt or Shift held, so SmartZoom can never take over a normal click." />

                <!-- The capture area. Clicking anywhere in it - or anywhere else that is not a control - records. -->
                <Border x:Name="CaptureArea"
                        Style="{StaticResource Card}"
                        Margin="0,16,0,0"
                        Padding="20,22,20,22"
                        MinHeight="112">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Captured"
                                   Style="{StaticResource Text.Base}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="Press a button or key combination…" />
                        <TextBlock x:Name="Caution"
                                   Style="{StaticResource Text.Body}"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Warn}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,18,0,0" Text="OR PICK A COMMON ONE" />
                <ItemsControl x:Name="Presets" Margin="0,8,-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Quiet}"
                                    Margin="0,0,8,8"
                                    Padding="13,0"
                                    Click="OnPreset"
                                    Content="{Binding Label}"
                                    Tag="{Binding Trigger}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,10,0,0" Text="HOW MANY PRESSES" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <RadioButton x:Name="EveryPress"
                                 VerticalContentAlignment="Center"
                                 Content="Every press"
                                 Foreground="{DynamicResource Brush.Ink}"
                                 IsChecked="True" />
                    <RadioButton x:Name="DoubleTap"
                                 Margin="20,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Content="Double-tap"
                                 Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock x:Name="WindowLabel"
                               Style="{StaticResource Text.Body}"
                               Margin="16,0,8,0"
                               VerticalAlignment="Center"
                               Text="within" />
                    <TextBox x:Name="WindowMs"
                             Width="70"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource Brush.Card}"
                             BorderBrush="{DynamicResource Brush.CardBorder}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource Brush.Ink}"
                             FontFamily="{StaticResource Font.Body}"
                             FontSize="13"
                             Foreground="{DynamicResource Brush.Ink}"
                             TextAlignment="Center" />
                    <TextBlock x:Name="WindowUnit"
                               Style="{StaticResource Text.Body}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="ms" />
                </StackPanel>

                <CheckBox x:Name="Swallow"
                          Margin="0,16,0,0"
                          VerticalContentAlignment="Center"
                          Content="Don't pass the press on to the app"
                          Foreground="{DynamicResource Brush.Ink}" />

                <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Quiet}"
                            Margin="0,0,10,0"
                            Padding="22,0"
                            Click="OnCancel"
                            Content="Cancel" />
                    <Button x:Name="Ok"
                            Style="{StaticResource Button.Pill}"
                            Height="36"
                            Padding="26,0"
                            Click="OnOk"
                            Content="OK"
                            IsEnabled="False" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
