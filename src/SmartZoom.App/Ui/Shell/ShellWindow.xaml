<Window x:Class="SmartZoom.App.Ui.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="SmartZoom settings"
        Width="1180"
        Height="860"
        MinWidth="900"
        MinHeight="640"
        Background="{DynamicResource Brush.Ground}"
        Foreground="{DynamicResource Brush.Ink}"
        FontFamily="{DynamicResource Font.Body}"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!--
        CaptionHeight makes the top 56 px drag the window the way a real caption does, while the client area
        reaches all the way up so the title bar below can be ours. GlassFrameThickness 0 keeps the desktop
        window manager from painting its own caption over it; the buttons inside opt back in to hit-testing.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource Brush.Ground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="9">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="15"
                                       Foreground="White"
                                       Text="&#xE8A3;" />
                        </Border>
                        <TextBlock Style="{StaticResource Text.Base}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Text="SmartZoom settings" />
                    </StackPanel>

                    <!-- Search: present and focusable, but nothing is searched yet. -->
                    <Border Grid.Column="1"
                            Width="320"
                            Height="34"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="17"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Glyph}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       Text="&#xE721;" />
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock x:Name="SearchHint"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           IsHitTestVisible="False"
                                           Text="Search settings…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="Search"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Brush.Ink}"
                                         FontFamily="{StaticResource Font.Body}"
                                         FontSize="13"
                                         Foreground="{DynamicResource Brush.Ink}"
                                         SelectionBrush="{DynamicResource Brush.Accent}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.TitleGlyph}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Command="{Binding CycleTheme}"
                            Content="{Binding ThemeGlyph}"
                            Tag="{Binding ThemeState}"
                            ToolTip="{Binding ThemeTooltip}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource Button.Caption}"
                                Click="OnMinimize"
                                Content="&#xE921;"
                                ToolTip="Minimize" />
                        <Button x:Name="MaximizeButton" Click="OnMaximizeOrRestore" ToolTip="Maximize or restore">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Caption}">
                                    <Setter Property="Content" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Content" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource Button.Close}"
                                Click="OnClose"
                                Content="&#xE8BB;"
                                ToolTip="Close. SmartZoom keeps running in the notification area." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rail and content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Brush.Rail}">
                    <Grid Margin="14,14,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 Style="{StaticResource Nav.List}"
                                 ItemContainerStyle="{StaticResource Nav.Item}"
                                 ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding Selected}" />

                        <Button Grid.Row="1"
                                Style="{StaticResource Card.Button}"
                                Command="{Binding ShowIssues}"
                                IsEnabled="{Binding HasIssues}"
                                ToolTip="Open the record of what did not work">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Good}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Muted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Margin="9,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13.5"
                                               Text="{Binding StatusHeadline}" />
                                </StackPanel>
                                <TextBlock Margin="18,4,0,0" FontSize="12.5" Text="{Binding StatusDetail}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="PageScroller"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
