<UserControl x:Class="SmartZoom.App.Ui.Pages.ApplicationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
    <UserControl.Resources>

        <!-- What a strategy is called, wherever one is offered or named. -->
        <DataTemplate x:Key="StrategyName">
            <TextBlock Style="{StaticResource Text.Base}" FontSize="13" Text="{Binding DisplayName}" />
        </DataTemplate>

        <!-- One of the user's own routes. -->
        <DataTemplate x:Key="RouteTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,14,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.CardTitle}" FontSize="14.5" Text="{Binding Process}" />
                        <TextBlock Style="{StaticResource Text.Muted}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{Binding Description}" />
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource Combo}"
                              Width="210"
                              VerticalAlignment="Top"
                              ItemTemplate="{StaticResource StrategyName}"
                              ItemsSource="{Binding DataContext.Strategies, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding Strategy}"
                              ToolTip="{Binding Description}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Quiet}"
                            Margin="8,0,0,0"
                            Padding="16,0"
                            VerticalAlignment="Top"
                            Command="{Binding DataContext.RemoveApplication, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="Remove" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One strategy's built-in claims: quiet, and deliberately not editable. -->
        <DataTemplate x:Key="BuiltInTemplate">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource Text.Muted}"
                           Margin="0,0,16,0"
                           FontWeight="SemiBold"
                           Text="{Binding DisplayName}"
                           ToolTip="{Binding Description}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Processes}" />
                    <TextBlock Style="{StaticResource Text.Muted}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Opacity="0.8"
                               Text="{Binding Description}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="40,34,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Heading -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Text.Hero}" FontSize="30" Text="Applications" />
            <TextBlock Style="{StaticResource Text.Muted}"
                       Margin="1,8,0,0"
                       MaxWidth="620"
                       HorizontalAlignment="Left"
                       Text="SmartZoom already knows about the applications listed under “Built in”. You only need a row of your own to change one of those, or to add something it has never heard of." />
        </StackPanel>

        <!-- 2. Yours -->
        <StackPanel Grid.Row="1" Margin="0,28,0,0" Orientation="Horizontal">
            <Border Width="28" Height="28" Background="{DynamicResource Brush.AccentTint}" CornerRadius="8">
                <TextBlock Style="{StaticResource Glyph}"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.Accent}"
                           Text="&#xECAA;" />
            </Border>
            <TextBlock Style="{StaticResource Text.Section}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Yours" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ItemsControl ItemTemplate="{StaticResource RouteTemplate}" ItemsSource="{Binding Routes}" />

            <TextBlock Margin="0,0,0,8" FontSize="12.5" Text="Nothing routed by hand yet.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRoutes}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 3. The add row: the same shape as a route, with the process name still to be typed. -->
            <Border Style="{StaticResource Card}" Padding="18,14,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding NewProcess, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The process name, with or without “.exe”." />
                        <TextBlock Style="{StaticResource Text.Muted}"
                                   Margin="2,5,0,0"
                                   FontSize="12"
                                   Text="Add an application… type its process name, for example “notepad”." />
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource Combo}"
                              Width="210"
                              VerticalAlignment="Top"
                              ItemTemplate="{StaticResource StrategyName}"
                              ItemsSource="{Binding Strategies}"
                              SelectedItem="{Binding NewStrategy}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Pill}"
                            Height="34"
                            Margin="8,0,0,0"
                            Padding="20,0"
                            VerticalAlignment="Top"
                            Command="{Binding AddApplication}"
                            Content="Add" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- 4. What the last change was told about itself -->
        <ItemsControl Grid.Row="3"
                      Margin="0,10,0,0"
                      ItemTemplate="{StaticResource Problem.Line}"
                      ItemsSource="{Binding Problems}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblems}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>

        <!-- 5. Built in -->
        <StackPanel Grid.Row="4" Margin="0,30,0,0" Orientation="Horizontal">
            <Border Width="28" Height="28" Background="{DynamicResource Brush.AccentTint}" CornerRadius="8">
                <TextBlock Style="{StaticResource Glyph}"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.Accent}"
                           Text="&#xE8A9;" />
            </Border>
            <TextBlock Style="{StaticResource Text.Section}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Built in" />
        </StackPanel>

        <Border Grid.Row="5"
                Style="{StaticResource Card}"
                Margin="0,14,0,0"
                Padding="20,18,20,6">
            <ItemsControl ItemTemplate="{StaticResource BuiltInTemplate}" ItemsSource="{Binding BuiltIn}" />
        </Border>

        <!-- 6. Footer -->
        <TextBlock Grid.Row="6"
                   Style="{StaticResource Text.Muted}"
                   Margin="0,14,0,0"
                   MaxWidth="620"
                   HorizontalAlignment="Left"
                   FontSize="12.5"
                   Text="A row of your own always wins over the built-in list, so naming an application here is also how you move it to another strategy or switch SmartZoom off for it." />
    </Grid>
</UserControl>
