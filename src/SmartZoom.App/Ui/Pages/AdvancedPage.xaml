<!--
    Placeholder. Advanced is where the zoom tuning, the diagnostics record and the logging level land in the
    second wave; see Settings/ZoomPage.cs and Settings/DiagnosticsPage.cs for what moves here.
-->
<UserControl x:Class="SmartZoom.App.Ui.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
    <StackPanel Margin="40,36,40,36">
        <TextBlock Style="{StaticResource Text.Hero}" FontSize="30" Text="Advanced" />
        <TextBlock Style="{StaticResource Text.Muted}"
                   Margin="0,10,0,0"
                   MaxWidth="560"
                   HorizontalAlignment="Left"
                   Text="How far and how quickly a zoom goes, how much PDFs zoom, what SmartZoom writes to its log, and the record of anything that went wrong. These still live in the old settings window; they move here next." />

        <TextBlock Style="{StaticResource Text.Section}" Margin="0,30,0,0" FontSize="16" Text="Sections coming here" />
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" Text="Zoom" />
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" Text="Diagnostics" />
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" Text="Logging and the settings file" />
    </StackPanel>
</UserControl>
